{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "regions": ["hnd1"],
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/rein-live",
      "schedule": "*/10 23,0-8 * * *"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 300,
      "memory": 2048
    }
  }
}
